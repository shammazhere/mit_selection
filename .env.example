# Environment Configuration
# Copy this file to .env and fill in the values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_PATH=data/scores.db

# CUSUM Configuration
CUSUM_THRESHOLD=5.0
CUSUM_SLACK=0.5
CUSUM_MEAN_EST=0.5

# Fusion Engine Configuration
SELF_WEIGHT=0.35
PEER_WEIGHT=0.35
DRIFT_WEIGHT=0.30

# Multiplier Configuration (optional - uses defaults if not set)
ROLE_ADMIN_WEIGHT=1.5
ROLE_PRIVILEGED_WEIGHT=1.3
TIME_BEFORE_7AM_WEIGHT=1.4
TIME_AFTER_8PM_WEIGHT=1.3
DATA_CONFIDENTIAL_WEIGHT=1.4
DATA_REMOVABLE_MEDIA_WEIGHT=1.3
