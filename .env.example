# Silent Shift — Environment Configuration
# Default values run seamlessly on localhost without modification.

# Backend API server configuration
PORT=8787
HOST=0.0.0.0

# Database storage path (defaults to backend/data/scores.db)
SILENT_SHIFT_DB=backend/data/scores.db

# Live endpoint sensor configuration (optional)
# When running live_agent.py against a remote hosted cloud server:
# SILENT_SHIFT_SERVER_URL=https://your-app.onrender.com
